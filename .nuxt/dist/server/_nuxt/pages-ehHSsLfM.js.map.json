t cherry, silky tannins, Oregon', price: '$16', image: 'https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=900&q=85' },\n  { category: 'Spirits', name: 'Barrel-aged rye', detail: 'Small-batch rye, served neat or on ice', price: '$18', image: 'https://images.unsplash.com/photo-1527281400683-1aae777175f8?auto=format&fit=crop&w=900&q=85' },\n]\n\nconst navItems = [\n  { label: 'Home', href: '#top' },\n  { label: 'Rooms', href: '#stay' },\n  { label: 'Events & Meetings', href: '#journal' },\n  { label: 'Restaurants', href: '#dining' },\n  { label: 'Contact', href: '#contact' },\n]\n\nfunction handleBooking() {\n  message.value = 'Availability request received — we will be in touch shortly.'\n}\n</script>\n\n<template>\n  <main class=\"min-h-screen bg-[#f4f1eb] text-[#1d2c2a]\">\n    <section id=\"top\" class=\"relative min-h-[680px] overflow-hidden bg-[#17302c] text-[#f8f5ef]\">\n      <img src=\"https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2200&q=90\" alt=\"Sunlit courtyard at Canvas Hotel\" class=\"absolute inset-0 h-full w-full object-cover opacity-70\">\n      <div class=\"absolute inset-0 bg-gradient-to-b from-[#0d211f]/65 via-transparent to-[#10201d]/80\" />\n      <header class=\"relative z-10 mx-auto flex max-w-7xl items-center justify-between px-6 py-7 lg:px-10\">\n        <a href=\"#top\" class=\"font-serif text-2xl tracking-[-0.04em]\">canvas hotel<span class=\"text-[#d4a77a]\">.</span></a>\n        <nav class=\"hidden items-center gap-9 text-sm md:flex\" aria-label=\"Main navigation\">\n          <a v-for=\"item in navItems\" :key=\"item.label\" :href=\"item.href\" class=\"transition-colors hover:text-[#e2b98d]\">{{ item.label }}</a>\n        </nav>\n        <div class=\"flex items-center gap-3\">\n          <a href=\"#book\" class=\"hidden border border-white/70 px-5 py-3 text-sm transition hover:bg-white hover:text-[#17302c] sm:block\">Book a stay</a>\n          <button aria-label=\"Open 